# Telegram Bot Credentials (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner Telegram Chat/User ID
OWNER_ID=your_telegram_id_here

# Telegram MTProto Credentials (from my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Server Configuration
PORT=8080
BIND_ADDRESS=0.0.0.0

# Optional: Custom domain or public IP (e.g. https://my-domain.com)
# Leave empty to use auto-provisioned Cloudflare Tunnel or local address.
SERVER_URL=

# Link expiration duration in days (default: 3 days)
LINK_EXPIRY_DAYS=3

# Optional: Private Telegram Storage / Bin Channel ID (e.g. -1001234567890)
# Files will be automatically backed up here so links never break even if users delete their messages.
BIN_CHANNEL=
